{
  "data_dir": "<DATA_ROOT>",
  "time_limit_seconds": 480,
  "stopping_rounds": 50,
  "model": {
    "objective": "binary",
    "metric": "binary_logloss",
    "boosting_type": "gbdt",
    "n_estimators": 600,
    "learning_rate": 0.05,
    "num_leaves": 31,
    "max_depth": -1,
    "max_bin": 63,
    "min_child_samples": 50,
    "reg_alpha": 0.0,
    "reg_lambda": 0.0,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "n_jobs": 4,
    "random_state": 0,
    "verbosity": -1
  }
}
